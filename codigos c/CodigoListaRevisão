#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define TAMANHO 10

int main() {
    int opcao;
    int vetor[TAMANHO];
    int qtd_elementos = 0;
    srand(time(NULL));

    do {
        system("cls");
        printf("MENU PRINCIPAL\n");
        printf("1 - Popular vetor com numeros aleatorios\n");
        printf("2 - Listar vetor populado\n");
        printf("3 - Ordenar vetor\n");
        printf("4 - Calcular e exibir a media aritmetica\n");
        printf("5 - Calcular e exibir a mediana\n");
        printf("6 - Localizar maior e menor valor\n");
        printf("7 - Sair do sistema\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1:
                printf("Populando o vetor com numeros aleatorios...\n");
                qtd_elementos = 0; // Reseta a contagem para novos elementos
                for (int i = 0; i < TAMANHO; i++) {
                    vetor[i] = rand() % 100;
                    qtd_elementos++;
                }
                printf("Vetor populado com sucesso!\n");
                break;

            case 2:
                printf("Listando o vetor com numeros aleatorios:\n");
                if (qtd_elementos > 0) {
                    for (int i = 0; i < TAMANHO; i++) {
                        printf("%d\t", vetor[i]);
                    }
                    printf("\n");
                } else {
                    printf("Vetor vazio. Nada a exibir.\n");
                }
                break;

            case 3:
                printf("Ordenando o vetor...\n");
                if (qtd_elementos > 0) {
                    // Ordenação simples (Bubble Sort)
                    for (int i = 0; i < TAMANHO - 1; i++) {
                        for (int j = 0; j < TAMANHO - i - 1; j++) {
                            if (vetor[j] > vetor[j + 1]) {
                                int temp = vetor[j];
                                vetor[j] = vetor[j + 1];
                                vetor[j + 1] = temp;
                            }
                        }
                    }
                    printf("Vetor ordenado com sucesso!\n");
                } else {
                    printf("Vetor vazio. Nada a ordenar.\n");
                }
                break;

            case 4: // a) Média aritmética
                if (qtd_elementos > 0) {
                    int soma = 0;
                    for (int i = 0; i < TAMANHO; i++) {
                        soma += vetor[i];
                    }
                    float media = (float)soma / TAMANHO;
                    printf("Media aritmetica dos valores: %.2f\n", media);
                } else {
                    printf("Vetor vazio. Nao e possivel calcular a media.\n");
                }
                break;

            case 5: // b) Mediana
                if (qtd_elementos > 0) {
                    // 1. Cria uma cópia para não alterar a ordem do vetor original sem permissão
                    int copia[TAMANHO];
                    for (int i = 0; i < TAMANHO; i++) {
                        copia[i] = vetor[i];
                    }

                    // 2. Ordena a cópia do vetor
                    for (int i = 0; i < TAMANHO - 1; i++) {
                        for (int j = 0; j < TAMANHO - i - 1; j++) {
                            if (copia[j] > copia[j + 1]) {
                                int temp = copia[j];
                                copia[j] = copia[j + 1];
                                copia[j + 1] = temp;
                            }
                        }
                    }

                    // 3. Calcula a mediana
                    float mediana;
                    if (TAMANHO % 2 != 0) {
                        // Se o tamanho for ímpar, pega o elemento do meio
                        mediana = copia[TAMANHO / 2];
                    } else {
                        // Se for par, faz a média dos dois centrais
                        int meio1 = copia[(TAMANHO / 2) - 1];
                        int meio2 = copia[TAMANHO / 2];
                        mediana = (meio1 + meio2) / 2.0;
                    }

                    printf("Mediana dos valores: %.2f\n", mediana);
                } else {
                    printf("Vetor vazio. Nao e possivel calcular a mediana.\n");
                }
                break;

            case 6: // c) Menor e Maior valor
                if (qtd_elementos > 0) {
                    int menor = vetor[0];
                    int maior = vetor[0];

                    for (int i = 1; i < TAMANHO; i++) {
                        if (vetor[i] < menor) {
                            menor = vetor[i];
                        }
                        if (vetor[i] > maior) {
                            maior = vetor[i];
                        }
                    }

                    printf("Menor valor encontrado: %d\n", menor);
                    printf("Maior valor encontrado: %d\n", maior);
                } else {
                    printf("Vetor vazio. Nao e possivel buscar maior/menor.\n");
                }
                break;

            case 7:
                printf("Sistema encerrado.\n");
                break;

            default:
                printf("Opcao invalida. Redigite.\n");
                break;
        }
        system("pause");
    } while (opcao != 7);

    return 0;
}