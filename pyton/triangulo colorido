def inicializaExercicio2_e_3():
    """Ex2 e Ex3: Dois triângulos (um invertido) no mesmo VAO/VBO (6 vértices total)"""
    global Vao_Ex2_3
    
    Vao_Ex2_3 = glGenVertexArrays(1)
    glBindVertexArray(Vao_Ex2_3)

    # Ex 3: Inverte o sinal do eixo Y para deixar o segundo triângulo de cabeça para baixo
    pontos = [
        # Triângulo 1 (Normal - Esquerda)
        -0.6,  0.4, 0.0,
        -0.3, -0.2, 0.0,
        -0.9, -0.2, 0.0,
        # Triângulo 2 (Invertido no eixo Y - Direita)
        0.6, -0.4, 0.0,  # Invertido Y
        0.9,  0.2, 0.0,  # Invertido Y
        0.3,  0.2, 0.0   # Invertido Y
    ]
    pontos = np.array(pontos, dtype=np.float32)

    pvbo = glGenBuffers(1)
    glBindBuffer(GL_ARRAY_BUFFER, pvbo)
    glBufferData(GL_ARRAY_BUFFER, pontos, GL_STATIC_DRAW)
    glEnableVertexAttribArray(0)
    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 0, None)

    # Ex 1: Tons de azul e azul marinho aplicados a todos os vértices
    cores = [
        0.0,  0.0,  1.0,   # Azul Puro
        0.0,  0.0,  0.5,   # Azul Escuro
        0.0,  0.0,  0.31,  # Azul Marinho
        
        0.0,  0.0,  0.31,  # Azul Marinho
        0.10, 0.10, 0.27,  # Azul Meia-Noite
        0.26, 0.44, 0.76   # Azul Royal
    ]
    cores = np.array(cores, dtype=np.float32)

    cvbo = glGenBuffers(1)
    glBindBuffer(GL_ARRAY_BUFFER, cvbo)
    glBufferData(GL_ARRAY_BUFFER, cores, GL_STATIC_DRAW)
    glEnableVertexAttribArray(1)
    glVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, 0, None)


