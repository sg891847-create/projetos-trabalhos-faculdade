def inicializaQuadrado():
    """Ex5: Inicializa a geometria do Quadrado (2 triângulos = 6 vértices) no lado Esquerdo"""
    global Vao_Quadrado
    Vao_Quadrado = glGenVertexArrays(1)
    glBindVertexArray(Vao_Quadrado)

    # Coordenadas do Quadrado (X, Y, Z)
    pontos = [
        -0.7,  0.3, 0.0,  # T1: Cima Esquerda
        -0.3,  0.3, 0.0,  # T1: Cima Direita
        -0.7, -0.1, 0.0,  # T1: Baixo Esquerda

        -0.3,  0.3, 0.0,  # T2: Cima Direita
        -0.3, -0.1, 0.0,  # T2: Baixo Direita
        -0.7, -0.1, 0.0   # T2: Baixo Esquerda
    ]
    pontos = np.array(pontos, dtype=np.float32)
    pvbo = glGenBuffers(1)
    glBindBuffer(GL_ARRAY_BUFFER, pvbo)
    glBufferData(GL_ARRAY_BUFFER, pontos, GL_STATIC_DRAW)
    glEnableVertexAttribArray(0)
    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 0, None)

    # Cores em tons de Azul Marinho e Ciano para o Quadrado
    cores = [
        0.0, 0.0, 0.5,   0.0, 0.0, 0.31,  0.0, 0.0, 0.2,
        0.0, 0.0, 0.31,  0.0, 0.5, 0.5,   0.0, 0.0, 0.2
    ]
    cores = np.array(cores, dtype=np.float32)
    cvbo = glGenBuffers(1)
    glBindBuffer(GL_ARRAY_BUFFER, cvbo)
    glBufferData(GL_ARRAY_BUFFER, cores, GL_STATIC_DRAW)
    glEnableVertexAttribArray(1)
    glVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, 0, None)


def inicializaTriangulo():
    """Ex5: Inicializa a geometria do Triângulo independente no lado Direito"""
    global Vao_Triangulo
    Vao_Triangulo = glGenVertexArrays(1)
    glBindVertexArray(Vao_Triangulo)

    pontos = [
        0.5,  0.3, 0.0,  # Cima
        0.8, -0.1, 0.0,  # Direita
        0.2, -0.1, 0.0   # Esquerda
    ]
    pontos = np.array(pontos, dtype=np.float32)
    pvbo = glGenBuffers(1)
    glBindBuffer(GL_ARRAY_BUFFER, pvbo)
    glBufferData(GL_ARRAY_BUFFER, pontos, GL_STATIC_DRAW)
    glEnableVertexAttribArray(0)
    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 0, None)

    # Cores em tons de Azul Royal e Vivo
    cores = [
        0.0,  0.0,  1.0,   # Azul Puro
        0.26, 0.44, 0.76,  # Azul Royal
        0.0,  0.0,  0.31   # Azul Marinho
    ]
    cores = np.array(cores, dtype=np.float32)
    cvbo = glGenBuffers(1)
    glBindBuffer(GL_ARRAY_BUFFER, cvbo)
    glBufferData(GL_ARRAY_BUFFER, cores, GL_STATIC_DRAW)
    glEnableVertexAttribArray(1)
    glVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, 0, None)


# --- FUNÇÕES DE COMPILAÇÃO DE SHADERS (Ex5) ---

def criarShader(vertex_code, fragment_code):
    vs = OpenGL.GL.shaders.compileShader(vertex_code, GL_VERTEX_SHADER)
    fs = OpenGL.GL.shaders.compileShader(fragment_code, GL_FRAGMENT_SHADER)
    program = OpenGL.GL.shaders.compileProgram(vs, fs)
    glDeleteShader(vs)
    glDeleteShader(fs)
    return program

def inicializaShaderQuadrado():
    global Shader_Quadrado
    # Shader padrão que recebe e usa as cores enviadas pelos VBOs
    v_code = """#version 400
    layout(location = 0) in vec3 vertex_posicao;
    layout(location = 1) in vec3 vertex_cores;
    out vec3 cores;
    void main () {
        cores = vertex_cores;
        gl_Position = vec4(vertex_posicao, 1.0);
    }"""
    f_code = """#version 400
    in vec3 cores;
    out vec4 frag_colour;
    void main () {
        frag_colour = vec4 (cores, 1.0);
    }"""
    Shader_Quadrado = criarShader(v_code, f_code)

def inicializaShaderTriangulo():
    global Shader_Triangulo
    # Um shader diferente: este inverte os canais de cores no Fragment Shader para teste
    v_code = """#version 400
    layout(location = 0) in vec3 vertex_posicao;
    layout(location = 1) in vec3 vertex_cores;
    out vec3 cores;
    void main () {
        cores = vertex_cores;
        gl_Position = vec4(vertex_posicao, 1.0);
    }"""
    f_code = """#version 400
    in vec3 cores;
    out vec4 frag_colour;
    void main () {
        // Multiplica a cor por um fator para torná-lo um azul ainda mais brilhante/personalizado
        frag_colour = vec4 (cores.r * 0.5, cores.g, cores.b * 1.2, 1.0);
    }"""
    Shader_Triangulo = criarShader(v_code, f_code)


